# Copy to .env and fill in. Never commit .env.
DATABASE_PATH=liveteach.db
JWT_SECRET=put-a-long-random-string-here
DEMO_QUESTION_LIMIT=3

# AI model (OpenAI-compatible API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Razorpay defaults. Each teacher's own keys and commission % are set per teacher in the admin panel;
# these values are only used for a teacher with none set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_LINKED_ACCOUNT=acc_XXXXXXXXXXXX
PLATFORM_COMMISSION_PERCENT=20

# Dhurina admin panel (open https://<server>/admin)
ADMIN_EMAIL=owner@dhurina.in                 # first owner login, created on first start
ADMIN_PASSWORD=change-this-strong-password  # change it from Settings after first login
SECRETS_KEY=put-another-long-random-string-here   # encrypts teachers' Razorpay secrets; never change after launch
PUBLIC_BASE_URL=https://api.example.com          # this server's public address (for app builds)
AVATAR_DIR=avatars

# "Build app" button: GitHub fine-grained token with Actions read & write on the repo
GITHUB_TOKEN=
GITHUB_REPO=binturaathore05-collab/DhurinaAI

# Teacher dashboard login key, one per teacher id
TEACHER_KEY_SUBHASH=put-a-long-random-string-here

# Optional cheaper model for small helper jobs (search keywords). Empty = use LLM_MODEL for everything.
LLM_SMALL_MODEL=
NOTES_DIR=notes_pdfs
# Share links go to <PUBLIC_BASE_URL>/t/<teacher id> (teacher page with a 'Get the app' button)
PUBLIC_BASE_URL=https://liveteach.example.com

# Behind our own proxy / load balancer only: read the student IP from X-Forwarded-For (OTP-per-IP limit)
TRUST_PROXY=0
